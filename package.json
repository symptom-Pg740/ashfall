{
  "name": "ashfall-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm run typecheck && npm run test && npm run check:boundaries && npm run build"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^7.1.0",
    "vitest": "^4.1.12"
  }
}
